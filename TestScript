pm.test("Response status code is 200", function () {
    pm.expect(pm.response.code).to.eql(200);
});

pm.test("Response time is less than 2000ms", function () {
    pm.expect(pm.response.responseTime).to.be.below(2000);
});

pm.test("Response has the required fields", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData).to.have.all.keys('page', 'per_page', 'total', 'total_pages', 'data', 'support');
});

pm.test("Validate the schema of the 'data' array", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData.data).to.be.an('array');

    responseData.data.forEach(function(user) {
        pm.expect(user).to.be.an('object');
        pm.expect(user).to.have.all.keys('id', 'email', 'first_name', 'last_name', 'avatar');
    });
});

pm.test("Email in the data array is in a valid format", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData.data).to.be.an('array').that.is.not.empty;

    responseData.data.forEach(function(user) {
        pm.expect(user.email).to.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/, "Email format is invalid");
    });
});

pm.test("Response has a Content-Type of application/json", function () {
    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');
});

pm.test("Total pages is a non-negative integer", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData.total_pages).to.be.a('number').and.to.be.at.least(0);
});

pm.test("Support object has required fields", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.have.property('support');
    pm.expect(responseData.support).to.have.all.keys('url', 'text');
});

pm.test("The 'data' array should not be empty when there are users present", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData.data).to.be.an('array').that.is.not.empty;
});

pm.test("Each user's first_name and last_name are non-empty strings", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.have.property('data').that.is.an('array');
    
    responseData.data.forEach(user => {
        pm.expect(user.first_name).to.exist.and.to.be.a('string').and.to.have.lengthOf.at.least(1, "first_name should not be empty");
        pm.expect(user.last_name).to.exist.and.to.be.a('string').and.to.have.lengthOf.at.least(1, "last_name should not be empty");
    });
});

pm.test("Response body contains a valid 'page' number", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData.page).to.be.a('number').and.to.be.at.least(0);
});

pm.test("Response contains a non-negative 'per_page' value", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData.per_page).to.be.a('number').and.to.be.at.least(0);
});

pm.test("Support URL is in a valid URL format", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData).to.be.an('object');
    pm.expect(responseData.support).to.exist;
    pm.expect(responseData.support.url).to.match(/^(http|https):\/\/[^\s/$.?#].[^\s]*$/, "Support URL is not in a valid format");
});

pm.test("Response time is less than 1000ms", function () {
    pm.expect(pm.response.responseTime).to.be.below(1000);
});

pm.test("Total number of users returned is equal to the number of items in the 'data' array", function () {
    const responseData = pm.response.json();
    
    pm.expect(responseData.total).to.equal(responseData.data.length);
});

